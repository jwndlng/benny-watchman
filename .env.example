# =============================================================================
# benny-watchman — environment variables
# Copy to .env. This file holds SECRETS and local/deploy overrides ONLY.
# All non-secret settings live in config.toml (see config.toml.example).
# Precedence: env > config.toml > defaults.
# =============================================================================

# -----------------------------------------------------------------------------
# Secrets (env-only — never put these in config.toml)
# -----------------------------------------------------------------------------

# Model provider API key. Maps to ANTHROPIC_API_KEY / GEMINI_API_KEY /
# OPENAI_API_KEY automatically based on [agent].model.
AGENT_MODEL_API_KEY=

# Elasticsearch API key — required when [data.elastic] is configured.
ELASTIC_API_KEY=

# Kibana API key: alerts read + signal-status write + Cases (never remediation).
# Required when [kibana] is configured. Must have privileges in the target space.
KIBANA_TRIAGE_API_KEY=

# Okta secrets — required when [okta] is configured.
OKTA_CLIENT_ID=
OKTA_PRIVATE_KEY=

# MCP bearer token. If unset, a random token is generated and printed at startup.
MCP_BEARER_TOKEN=

# Logfire project token (secret). Omit to run without observability.
LOGFIRE_TOKEN=

# -----------------------------------------------------------------------------
# Local / deploy overrides (optional)
# -----------------------------------------------------------------------------

# Path to the TOML config file (default: config.toml).
# CONFIG_FILE=config.toml

# Override any non-secret setting with SECTION__FIELD (double underscore), e.g.:
# AGENT__MODEL=anthropic:claude-sonnet-4-6
# KIBANA__URL=https://my-kibana.kb.io/s/isec

# Dev only: seed the in-memory triage platform from a JSON array of raw alerts
# (used when [kibana] is absent) — exercise the triage loop without Elastic.
TRIAGE_SEED_ALERTS=

# -----------------------------------------------------------------------------
# Observability (env-driven)
# -----------------------------------------------------------------------------

# Root log level: DEBUG | INFO | WARNING | ERROR (default INFO).
LOG_LEVEL=INFO

# Log line format: console | json (default console).
LOG_FORMAT=console
