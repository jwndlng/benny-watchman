# =============================================================================
# benny-watchman — local dev environment
# Copy this file to .env and fill in your values.
# =============================================================================

# -----------------------------------------------------------------------------
# LLM Agent
# -----------------------------------------------------------------------------

# Model identifier. Format: <provider>:<model-id>
# Supported providers: anthropic, google-gla, openai
# Example values:
#   anthropic:claude-sonnet-4-6
#   google-gla:gemini-2.0-flash
#   openai:gpt-4o
AGENT_MODEL=google-gla:gemini-2.0-flash

# API key for the selected model provider.
# Maps to ANTHROPIC_API_KEY / GEMINI_API_KEY / OPENAI_API_KEY automatically.
AGENT_MODEL_API_KEY=

# Maximum number of tool calls the AnalystAgent may make per investigation.
AGENT_MAX_REQUESTS=15

# Maximum number of tool calls each DataAgent may make per query.
AGENT_MAX_DATA_REQUESTS=10

# -----------------------------------------------------------------------------
# Data backend (security logs)
# -----------------------------------------------------------------------------

# Backend engine: sqlite | elasticsearch
DATA_BACKEND_ENGINE=sqlite

# Path to the SQLite database (only used when DATA_BACKEND_ENGINE=sqlite).
# Leave empty or point to a seeded DB. No data = agent finds nothing to query.
DATA_BACKEND_DB_PATH=data.db

# Logical name for the data agent shown in routing descriptions.
DATA_AGENT_NAME=security_logs

# -----------------------------------------------------------------------------
# Vulnerability Management module
# -----------------------------------------------------------------------------

# SQLite asset/vulnerability inventory for the VM module (dev).
# Seed with: uv run python tests/harness/seeder/asset_db.py --db-path vuln.db --reset
VULN_DB_PATH=vuln.db

# VM runbooks directory.
VULN_RUNBOOKS_PATH=src/modules/vuln_mgmt/runbooks

# Logical name for the VM asset-inventory data agent.
VULN_DATA_AGENT_NAME=asset_inventory

# -----------------------------------------------------------------------------
# Investigation persistence
# -----------------------------------------------------------------------------

# SQLite database for storing completed investigations.
# Ephemeral in Docker (no volume mount) — lost on container stop.
PERSISTENCE_DB_PATH=investigations.db

# -----------------------------------------------------------------------------
# Runbooks
# -----------------------------------------------------------------------------

# Path to the SIEM runbooks directory (relative to project root).
RUNBOOKS_PATH=src/modules/siem/runbooks

# -----------------------------------------------------------------------------
# Elasticsearch data backend (optional)
# When set, an ElasticDataAgent is constructed alongside any SQLite data agents.
# Omit ELASTIC_HOST or ELASTIC_API_KEY to disable.
# -----------------------------------------------------------------------------

# Elasticsearch host URL, e.g. https://my-cluster.es.io:9200
ELASTIC_HOST=

# API key for Elasticsearch.
ELASTIC_API_KEY=

# Optional glob pattern to filter which indices are exposed to the agent.
# When set, only matching indices are returned by list_tables (e.g. logs-*).
# When unset, all non-hidden indices (not starting with .) are returned.
ELASTIC_INDEX_PATTERN=

# -----------------------------------------------------------------------------
# Triage platform — Kibana / Elastic Security (optional)
# Where Benny fetches open alerts and writes back verdicts (comment, case,
# severity, status). Distinct from the Elasticsearch DATA source above:
#   DataAgent  -> Elasticsearch API (ELASTIC_* above; reads logs)
#   Platform   -> Kibana API        (KIBANA_* here; alerts + cases)
# Both KIBANA_URL and KIBANA_TRIAGE_API_KEY are required to activate the Elastic
# platform; otherwise Benny uses the in-memory platform (see TRIAGE_SEED_ALERTS).
# -----------------------------------------------------------------------------

# Kibana base URL, e.g. https://my-kibana.kb.io:5601 (NOT the ES host).
KIBANA_URL=

# API key scoped to: alerts read + signal-status write + Cases (never remediation).
# See openspec/changes/elastic-triage-platform for the role policy.
KIBANA_TRIAGE_API_KEY=

# Case owner for created cases (Kibana Cases feature). Default: securitySolution.
KIBANA_CASE_OWNER=securitySolution

# Dev only: seed the in-memory triage platform from a JSON file of raw alerts
# (used when KIBANA_URL is unset) — exercise the triage loop / review_newest_alert
# without Elastic.
TRIAGE_SEED_ALERTS=

# -----------------------------------------------------------------------------
# MCP server (optional)
# The app exposes a Streamable HTTP MCP server at /mcp for local AI tool access.
# On first start without MCP_BEARER_TOKEN set, a random token is generated and
# printed to stdout. Copy it here to keep a stable token across restarts.
#
# Claude Code config snippet (~/.claude/claude_desktop_config.json):
#   "mcpServers": {
#     "benny": {
#       "type": "http",
#       "url": "http://localhost:5000/mcp/",
#       "headers": { "Authorization": "Bearer <token>" }
#     }
#   }
# -----------------------------------------------------------------------------

MCP_BEARER_TOKEN=

# -----------------------------------------------------------------------------
# Okta IDP integration (optional)
# Omit or leave blank to disable — lookup_user returns None when unconfigured.
# -----------------------------------------------------------------------------

# Your Okta organisation URL, e.g. https://company.okta.com
OKTA_DOMAIN=

# OAuth2 client ID for the Okta app configured with JWT private key auth.
OKTA_CLIENT_ID=

# Base64-encoded JWK private key for the Okta app.
# Generate with: base64 < private-key.json | tr -d '\n'
OKTA_PRIVATE_KEY=

# -----------------------------------------------------------------------------
# Observability (optional)
# -----------------------------------------------------------------------------

# Logfire project token for traces and spans.
# Omit to run without observability (a warning is logged but the app starts).
# When set, Logfire console output is disabled so traces go only to the backend
# and the local console keeps the single unified log format (see LOG_FORMAT).
LOGFIRE_TOKEN=

# Root log level: DEBUG | INFO | WARNING | ERROR (default INFO).
# At DEBUG, noisy per-request loggers (httpx, elasticsearch) are also verbose;
# otherwise they are gated to WARNING so startup/triage logs stay readable.
LOG_LEVEL=INFO

# Log line format: console | json.
#   console (default) — colored, human-readable (colors auto-disable when stdout
#                       is not a TTY, e.g. piped to a file).
#   json              — one structured JSON object per line, for Vector in production.
LOG_FORMAT=console
